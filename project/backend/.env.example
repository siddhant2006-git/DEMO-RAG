# App
APP_NAME=TenderGuard
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://tenderguard:tenderguard@localhost:5432/tenderguard

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# Windows only, when tesseract isn't on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Government verification: mock | live
VERIFICATION_MODE=mock
VERIFICATION_CACHE_TTL_SECONDS=3600

# Storage
UPLOAD_DIR=./data/uploads
VECTORSTORE_DIR=./data/vectorstore
MOCK_PORTAL_DIR=./data/mock_portals
MAX_UPLOAD_MB=50

# CORS
CORS_ORIGINS=http://localhost:5173

# Authentication (replace both secrets outside local development)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
